6809,45.91549]}},{"type":"Feature","properties":{"id":"pieve-feletto","nome":"Pieve di San Pietro di Feletto","tipo":"luogo","cat":"pieve","tier":2,"desc":"Pieve romanica (XII sec.) con il celebre affresco del “Cristo della Domenica” sul portico. Terrazza naturale sulle colline.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.23721,45.93041]}},{"type":"Feature","properties":{"id":"castello-collalto","nome":"Castello di Collalto","tipo":"luogo","cat":"castello","tier":2,"desc":"Ruderi del castello duecentesco dei conti di Collalto, distrutto nella Grande Guerra; il borgo conserva il suo impianto.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.19682,45.87352]}},{"type":"Feature","properties":{"id":"castello-san-salvatore","nome":"Castello di San Salvatore","tipo":"luogo","cat":"castello","tier":3,"desc":"Grande castello dei Collalto sopra Susegana, affacciato sul Piave.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.23488,45.85074]}},{"type":"Feature","properties":{"id":"campanile-roganzuolo","nome":"Il Campanile di Castello Roganzuolo","tipo":"luogo","cat":"campanile","tier":3,"desc":"La chiesa con il campanile sul colle del vecchio castello; all’interno opere di Tiziano e bottega.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.33711,45.92324]}},{"type":"Feature","properties":{"id":"san-vigilio","nome":"Chiesa di San Vigilio","tipo":"luogo","cat":"chiesa","tier":3,"desc":"Chiesetta romanica sul colle sopra Col San Martino, tra i cipressi: il simbolo delle colline del Prosecco.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.09335,45.89817]}},{"type":"Feature","properties":{"id":"cartizze","nome":"Zona del Cartizze","tipo":"luogo","cat":"zona","tier":2,"desc":"Il “cru” del Prosecco Superiore: 108 ettari tra San Pietro di Barbozza, Santo Stefano e Saccol, le vigne più pregiate della Denominazione.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.03426,45.89919]}},{"type":"Feature","properti