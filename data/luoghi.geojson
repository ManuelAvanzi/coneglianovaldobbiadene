{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"id":"conegliano","nome":"Conegliano","tipo":"citta","cat":null,"tier":1,"desc":"Capoluogo orientale della Denominazione. Città murata ai piedi del Castello, patria di Giovanni Battista Cima; qui ha sede la Scuola Enologica più antica d’Italia (1876).","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.29776,45.88622]}},{"type":"Feature","properties":{"id":"valdobbiadene","nome":"Valdobbiadene","tipo":"citta","cat":null,"tier":1,"desc":"Capoluogo occidentale della Denominazione, ai piedi delle Prealpi. Attorno al paese si aprono le colline del Cartizze e il cuore storico del Prosecco Superiore.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[11.99551,45.90141]}},{"type":"Feature","properties":{"id":"vittorio-veneto","nome":"Vittorio Veneto","tipo":"citta","cat":null,"tier":1,"desc":"Nata nel 1866 dall’unione di Serravalle e Ceneda. Porta d’accesso alle Prealpi e alla Val Lapisina; il nome ricorda la vittoria del 1918.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.29585,45.98982]}},{"type":"Feature","properties":{"id":"pieve-di-soligo","nome":"Pieve di Soligo","tipo":"paese","cat":null,"tier":1,"desc":"Centro del Quartier del Piave, paese natale del poeta Andrea Zanzotto. Mercato, botteghe e il fiume Soligo tra le colline.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.17308,45.89976]}},{"type":"Feature","properties":{"id":"follina","nome":"Follina","tipo":"paese","cat":null,"tier":2,"desc":"Borgo di lanifici lungo il torrente Soligo, cresciuto attorno all’Abbazia cistercense di Santa Maria.","fonte":"osm"},"geometry":{"type":"Point","coordinates":[12.11814,45.95307]}},{"type":"Feature","properties":{"id":"cison-di-valmarino","nome":"Cison di Valmarino","tipo":"paese","cat":null,"tier":2,"desc":"Uno dei Borghi più belli d’Italia, dominato da CastelBrando. Via dei Mulini, Palazzo Brandolini e la grande festa Artigianato Vivo.","fonte":"osm"},"geometr